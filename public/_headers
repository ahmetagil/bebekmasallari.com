# Cloudflare Pages için güvenlik başlıkları
# Bu dosya public/ klasöründe, build sonrası dist/_headers olarak çıkar.
# Cloudflare Pages otomatik uygular — dashboard ayarı gerekmez.

/*
  # Clickjacking koruması
  X-Frame-Options: SAMEORIGIN
  # MIME sniffing koruması
  X-Content-Type-Options: nosniff
  # Referrer kontrolü (zaten Cloudflare ekliyor ama garantiye al)
  Referrer-Policy: strict-origin-when-cross-origin
  # Tarayıcı özellik izinleri (kamera, mikrofon, konum kapalı)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  # Content Security Policy — kendi domaininden her şey, inline style/script izinli
  # (Astro scoped stilleri inline olduğu için 'unsafe-inline' gerekli)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Statik varlıklar uzun süre önbelleğe alınsın (Astro hashed dosya adları)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
