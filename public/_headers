# Cloudflare Pages için güvenlik başlıkları
# Bu dosya public/ klasöründe, build sonrası dist/_headers olarak çıkar.
# Cloudflare Pages otomatik uygular — dashboard ayarı gerekmez.

/*
  # Clickjacking koruması
  X-Frame-Options: SAMEORIGIN
  # MIME sniffing koruması
  X-Content-Type-Options: nosniff
  # Referrer kontrolü (zaten Cloudflare ekliyor ama garantiye al)
  Referrer-Policy: strict-origin-when-cross-origin
  # Tarayıcı özellik izinleri (kamera, mikrofon, konum kapalı)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  # Content Security Policy — kendi domaini + Google AdSense domainleri izinli
  # (Astro scoped stilleri inline olduğu için style 'unsafe-inline' gerekli;
  #  AdSense frame/iframe kullandığı için frame-src ve child-src açık)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://www.googletagservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.google.com; frame-src https://googleads.g.doubleclick.net https://www.google.com https://tpc.googlesyndication.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Statik varlıklar uzun süre önbelleğe alınsın (Astro hashed dosya adları)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
